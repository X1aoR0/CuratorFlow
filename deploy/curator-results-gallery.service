[Unit]
Description=CuratorFlow Results Gallery
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/curator-flow

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/curator-flow/results-gallery
ExecStart=/usr/bin/python3 -m http.server 8765 --bind 0.0.0.0 --directory /mnt/curator-flow/results-gallery
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
